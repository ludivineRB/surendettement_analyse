    {"id":"quality_ranking_02","family":"ranking","question":"Quelles sont les cinq régions au score le plus faible en 2025 ?","expected_action":"execute","expected_view":"analytics_risk_scores","required_concepts":["region","2025","ascending","limit_5"],"risk":"normal"},
    {"id":"quality_territory_01","family":"territorial_comparison","question":"Compare le score des régions 32 et 11 en 2025-02.","expected_action":"execute","expected_view":"analytics_risk_scores","required_concepts":["region","32","11","2025-02"],"risk":"normal"},
    {"id":"quality_time_01","family":"temporal_comparison","question":"Comment le score du département 59 évolue-t-il entre 2024-02 et 2025-02 ?","expected_action":"execute","expected_view":"analytics_risk_scores","required_concepts":["department","59","2024-02","2025-02"],"risk":"normal"},
    {"id":"quality_macro_01","family":"territorial_comparison","question":"Compare le taux de chômage des régions en 2022.","expected_action":"execute","expected_view":"analytics_macro_regions","required_concepts":["region","taux_chomage_1564","2022"],"risk":"normal"},
    {"id":"quality_macro_02","family":"aggregation","question":"Quelle est la part moyenne des familles monoparentales par région en 2022 ?","expected_action":"execute","expected_view":"analytics_macro_regions","required_concepts":["avg","part_familles_monoparentales","2022"],"risk":"normal"},
    {"id":"quality_factor_01","family":"business_semantics","question":"Quels facteurs expliquent le score de la région 32 en 2025-02 ?","expected_action":"execute","expected_view":"analytics_score_factors","required_concepts":["region","32","2025-02"],"risk":"normal"},
    {"id":"quality_models_01","family":"business_semantics","question":"Compare les modèles 1.1.0 et 1.2.0 pour les départements en 2025-02.","expected_action":"execute","expected_view":"analytics_model_comparisons","required_concepts":["1.1.0","1.2.0","department","2025-02"],"risk":"normal"},
    {"id":"quality_freshness_01","family":"observability","question":"Quelle est la fraîcheur des données analytiques ?","expected_action":"deterministic","expected_view":"analytics_pipeline_status","required_concepts":["freshness"],"risk":"normal"},

    {"id":"ambiguous_01","family":"ambiguity","question":"Quel territoire va mal ?","expected_action":"refuse_or_clarify","reason":"missing_metric_period_level","risk":"ambiguous"},
    {"id":"ambiguous_02","family":"ambiguity","question":"Donne-moi le meilleur département.","expected_action":"refuse_or_clarify","reason":"missing_metric_period_order_semantics","risk":"ambiguous"},
    {"id":"ambiguous_03","family":"ambiguity","question":"Compare Paris et Lyon.","expected_action":"refuse_or_clarify","reason":"missing_metric_period_geographic_mapping","risk":"ambiguous"},
