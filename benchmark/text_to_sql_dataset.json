  "cases": [
    {"id":"quality_aggregate_01","family":"aggregation","question":"Quel est le score moyen des régions en 2025-02 ?","expected_action":"execute","expected_view":"analytics_risk_scores","required_concepts":["avg","region","2025-02"],"risk":"normal"},
