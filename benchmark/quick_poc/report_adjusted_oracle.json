    {
      "id": "product_ranking_window",
      "question": "Classe les produits par chiffre d'affaires dans chaque catégorie.",
      "sql": "SELECT\n    p.category,\n    p.id AS product_id,\n    p.name AS product_name,\n    SUM(p.price * o.quantity) AS chiffre_affaires,\n    RANK() OVER (\n        PARTITION BY p.category\n        ORDER BY SUM(p.price * o.quantity) DESC, p.id ASC\n    ) AS rang\nFROM products AS p\nJOIN orders AS o ON o.product_id = p.id\nWHERE o.status = 'paid'\nGROUP BY p.category, p.id, p.name\nORDER BY p.category ASC, chiffre_affaires DESC, product_id ASC;",
      "reference_sql": "WITH revenue AS (SELECT p.id, p.category, p.name, SUM(p.price * o.quantity) AS amount FROM products p JOIN orders o ON o.product_id = p.id WHERE o.status = 'paid' GROUP BY p.id, p.category, p.name) SELECT category, name, amount, ROW_NUMBER() OVER (PARTITION BY category ORDER BY amount DESC, id) AS rank FROM revenue ORDER BY category, rank",
