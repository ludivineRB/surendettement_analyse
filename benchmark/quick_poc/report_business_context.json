    {
      "id": "product_ranking_window",
      "question": "Classe les produits par chiffre d'affaires dans chaque catégorie.",
      "sql": "WITH product_revenue AS (\n  SELECT\n    p.category,\n    p.id AS product_id,\n    p.name AS product_name,\n    COALESCE(SUM(p.price * o.quantity), 0) AS revenue\n  FROM products AS p\n  LEFT JOIN orders AS o\n    ON o.product_id = p.id\n   AND o.status = 'paid'\n  GROUP BY p.category, p.id, p.name\n)\nSELECT\n  category,\n  product_id,\n  product_name,\n  revenue,\n  ROW_NUMBER() OVER (\n    PARTITION BY category\n    ORDER BY revenue DESC, product_id ASC\n  ) AS ranking\nFROM product_revenue\nORDER BY category ASC, ranking ASC;",
      "reference_sql": "WITH revenue AS (SELECT p.category, p.name, SUM(p.price * o.quantity) AS amount FROM products p JOIN orders o ON o.product_id = p.id WHERE o.status = 'paid' GROUP BY p.id, p.category, p.name) SELECT category, name, amount, RANK() OVER (PARTITION BY category ORDER BY amount DESC) AS rank FROM revenue ORDER BY category, rank",
      "expected_read_only": true,
